# Server
PORT=5000
NODE_ENV=development

# PostgreSQL connection
# Either set DATABASE_URL, or set the individual PG_* values below.
DATABASE_URL=postgresql://syncspace_user:syncspace_password@localhost:5432/syncspace

PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=syncspace
PG_USER=syncspace_user
PG_PASSWORD=syncspace_password

# JWT
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Frontend origin allowed to call the API / connect via sockets
CLIENT_ORIGIN=http://localhost:5173
